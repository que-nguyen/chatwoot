# Adapter server
PORT=3001

# Chatwoot API inbox
# If running via Docker Compose overlay in this repo, use: http://rails:3000
# If running the adapter directly on the host, use: http://localhost:3000
CHATWOOT_BASE_URL=http://rails:3000
CHATWOOT_INBOX_IDENTIFIER=your_api_inbox_identifier
# Recommended: use an unguessable secret suffix in production (e.g. /webhooks/chatwoot/<secret>)
CHATWOOT_WEBHOOK_PATH=/webhooks/chatwoot/replace_with_secret
# Recommended: required if API inbox identity validation is enabled; also used to verify X-Chatwoot-Signature (when present)
CHATWOOT_HMAC_TOKEN=

# Zalo login (cookie mode)
ZALO_LOGIN_MODE=cookie
ZALO_COOKIE_PATH=./cookie.json
ZALO_COOKIE_JSON=
ZALO_IMEI=your_imei
ZALO_USER_AGENT=your_user_agent

# QR login (optional)
ZALO_QR_PATH=./qr.png

# Optional toggles
ZALO_DRY_RUN=false
ZALO_SELF_LISTEN=false
ZALO_CHECK_UPDATE=true
ZALO_LOGGING=true
ZALO_PROXY_URL=

# Multi-account (optional)
ZALO_ACCOUNTS_PATH=./accounts.json
# ZALO_ACCOUNTS_JSON=[{"label":"sales","chatwootInboxIdentifier":"..."}]
