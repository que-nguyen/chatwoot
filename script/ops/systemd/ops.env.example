# Chatwoot ops env (systemd units)
#
# Copy to: /etc/chatwoot/ops.env
# Then update the paths/values for your server.
#
# NOTE: This file is read by systemd's EnvironmentFile= directive (not bash),
# so keep it to simple KEY=VALUE lines.

# Absolute path to the Chatwoot repo on this server (required)
CHATWOOT_ROOT=/path/to/chatwoot

# Which env file Chatwoot containers should use (must match your stack)
CW_ENV_FILE=/path/to/chatwoot/.env

# Which docker compose files to include (space-separated)
# Example (base stack only):
# CW_COMPOSE_FILES="docker-compose.production.yaml"
# Example (Caddy overlay):
# CW_COMPOSE_FILES="docker-compose.production.yaml docker-compose.caddy.yaml"
# Example (Zalo adapter + Caddy overlays):
# CW_COMPOSE_FILES="docker-compose.production.yaml docker-compose.zalo-adapter.yaml docker-compose.caddy.yaml"
CW_COMPOSE_FILES="docker-compose.production.yaml"

# Backup settings (used by chatwoot-backup.service)
CW_BACKUP_DIR=backup
CW_BACKUP_KEEP_DAYS=14

# Healthcheck alerting (used by chatwoot-healthcheck.service; optional)
# CW_ALERT_WEBHOOK_MODE=slack
# CW_ALERT_WEBHOOK_URL=https://...
# CW_ALERT_PREFIX=chatwoot
