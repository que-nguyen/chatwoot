[Unit]
Description=Chatwoot Docker Compose healthcheck
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# %E resolves to /etc for system-scope and $XDG_CONFIG_HOME (default: ~/.config) for user-scope.
EnvironmentFile=-%E/chatwoot/ops.env
ExecStart=/usr/bin/env bash -c 'set -euo pipefail; if [[ -z "${CHATWOOT_ROOT:-}" ]]; then echo "CHATWOOT_ROOT is required (set it in %E/chatwoot/ops.env)" >&2; exit 2; fi; exec "${CHATWOOT_ROOT}/script/ops/chatwoot_healthcheck.sh"'
